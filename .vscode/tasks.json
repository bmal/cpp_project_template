{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake Configure Dev",
      "type": "shell",
      "command": "cmake --preset dev",
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "CMake Build Dev",
      "type": "shell",
      "command": "cmake --build --preset dev",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": ["CMake Configure Dev"],
      "problemMatcher": "$gcc"
    },
    {
      "label": "Run Unit Tests",
      "type": "shell",
      "command": "ctest --preset dev",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "dependsOn": ["CMake Build Dev"],
      "problemMatcher": "$gcc"
    },
    {
      "label": "CMake Configure Benchmarks",
      "type": "shell",
      "command": "cmake --preset bench",
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "CMake Build Benchmarks",
      "type": "shell",
      "command": "cmake --build --preset bench",
      "group": "build",
      "dependsOn": ["CMake Configure Benchmarks"],
      "problemMatcher": "$gcc"
    },
    {
      "label": "Run Benchmarks",
      "type": "shell",
      "command": "cmake --build --preset bench --target run_benchmarks",
      "group": "test",
      "dependsOn": ["CMake Build Benchmarks"]
    },
    {
      "label": "Run CLI",
      "type": "shell",
      "command": "build/dev/bin/myproj_cli",
      "group": "test",
      "dependsOn": ["CMake Build Dev"]
    }
  ]
}
