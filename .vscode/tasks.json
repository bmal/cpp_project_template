{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake Configure All",
      "type": "shell",
      "command": "cmake -S all -B build -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -DCMAKE_CXX_COMPILER=clang++ && ln -sf build/compile_commands.json .",
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "CMake Build All",
      "type": "shell",
      "command": "cmake --build build -j$(sysctl -n hw.ncpu)",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": ["CMake Configure All"],
      "problemMatcher": {
        "owner": "cpp",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "label": "CMake Configure Standalone",
      "type": "shell",
      "command": "cmake -S standalone -B build/standalone -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -DCMAKE_CXX_COMPILER=clang++",
      "group": "build"
    },
    {
      "label": "CMake Build Standalone",
      "type": "shell",
      "command": "cmake --build build/standalone -j$(sysctl -n hw.ncpu)",
      "group": "build",
      "dependsOn": ["CMake Configure Standalone"],
      "problemMatcher": {
        "owner": "cpp",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "./build/test/TradingTests",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "dependsOn": ["CMake Build All"]
    },
    {
      "label": "Run Standalone",
      "type": "shell",
      "command": "./build/standalone/trading_standalone",
      "group": "test",
      "dependsOn": ["CMake Build Standalone"]
    },
    {
      "label": "Clean Build",
      "type": "shell",
      "command": "rm -rf build/* .cache compile_commands.json",
      "group": "build"
    }
  ]
}
