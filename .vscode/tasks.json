{
  // Each task runs the Makefile target of its name; `make help` describes them.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "lint",
      "type": "shell",
      "command": "make lint",
      "problemMatcher": "$gcc"
    },
    {
      "label": "format",
      "type": "shell",
      "command": "make format",
      "problemMatcher": "$gcc"
    },
    {
      "label": "coverage",
      "type": "shell",
      "command": "make coverage",
      "group": "test",
      "problemMatcher": "$gcc"
    },
    {
      "label": "bench",
      "type": "shell",
      "command": "make bench",
      "group": "test",
      "problemMatcher": "$gcc"
    }
  ]
}
