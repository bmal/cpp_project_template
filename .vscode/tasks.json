{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}/standalone",
        "-B",
        "${workspaceFolder}/build/standalone",
        "-DUSE_STATIC_ANALYZER=clang-tidy"
      ],
      "group": "build",
      "problemMatcher": [],
      "detail": "CMake configuration"
    },
    {
      "label": "CMake: build",
      "type": "shell",
      "dependsOn": "CMake: configure",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build/standalone"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "detail": "CMake build task"
    },
    {
      "label": "CMake: run",
      "type": "shell",
      "dependsOn": "CMake: build",
      "command": "${workspaceFolder}/build/standalone/Trading",
      "args": ["--help"],
      "group": "none",
      "problemMatcher": [],
      "detail": "Run the built Trading executable with --help"
    },
    {
      "label": "CMake: debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}/standalone",
        "-B",
        "${workspaceFolder}/build/standalone",
        "-DCMAKE_BUILD_TYPE=Debug"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": [],
      "detail": "CMake debug build task"
    },
    {
      "label": "CMake: clean",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build/standalone",
        "--target",
        "clean"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": [],
      "detail": "CMake clean task"
    },
    {
      "label": "CMake: test",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}/test",
        "-B",
        "${workspaceFolder}/build/test"
      ],
      "group": {
        "kind": "test",
        "isDefault": false
      },
      "problemMatcher": [],
      "detail": "CMake test task"
    },
    {
      "label": "CMake: build test",
      "type": "shell",
      "dependsOn": "CMake: test",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build/test",
        "--target",
        "test",
        "--",
        "CTEST_OUTPUT_ON_FAILURE=1"
      ],
      "group": "test",
      "problemMatcher": [],
      "detail": "Build and run CMake tests"
    },
    {
      "label": "CMake: run tests",
      "type": "shell",
      "dependsOn": "CMake: build test",
      "command": "${workspaceFolder}/build/test/TradingTests",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "detail": "Run the TradingTests executable"
    }
  ]
}
