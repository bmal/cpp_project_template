# Package config for find_package(@PROJECT_NAME@). Every external package a module links is found here:
# modules are static, so even a PRIVATE dependency is linked into the consumer.
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(fmt CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")
check_required_components(@PROJECT_NAME@)
