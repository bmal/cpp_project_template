{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/toolchain.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PROJECT_COMPILER": "clang",
        "PROJECT_BUILD_APPS": "ON",
        "PROJECT_BUILD_TESTS": "ON",
        "PROJECT_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "host",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Darwin",
          "Linux"
        ]
      }
    },
    {
      "name": "host-linux",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "gcc",
      "hidden": true,
      "inherits": "host-linux",
      "cacheVariables": {
        "PROJECT_COMPILER": "gcc"
      }
    },
    {
      "name": "dev",
      "displayName": "Debug build with tests",
      "inherits": "host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PROJECT_STDLIB_HARDENING": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Optimized build with tests",
      "inherits": "host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "benchmarks",
      "displayName": "Optimized build with benchmarks",
      "inherits": "host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PROJECT_BUILD_APPS": "OFF",
        "PROJECT_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PROJECT_BUILD_APPS": "OFF",
        "PROJECT_SANITIZE": "address,undefined"
      }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer",
      "inherits": "host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PROJECT_BUILD_APPS": "OFF",
        "PROJECT_SANITIZE": "thread"
      }
    },
    {
      "name": "coverage",
      "displayName": "Debug build with coverage instrumentation",
      "inherits": "host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PROJECT_BUILD_APPS": "OFF",
        "ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "dev-gcc",
      "displayName": "Debug build with tests, GCC",
      "inherits": [
        "gcc",
        "dev"
      ]
    },
    {
      "name": "release-gcc",
      "displayName": "Optimized build with tests, GCC",
      "inherits": [
        "gcc",
        "release"
      ]
    },
    {
      "name": "coverage-gcc",
      "displayName": "Debug build with gcov coverage, GCC",
      "inherits": [
        "gcc",
        "coverage"
      ],
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "--coverage -fno-inline",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "benchmarks",
      "configurePreset": "benchmarks"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "dev-gcc",
      "configurePreset": "dev-gcc",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "release-gcc",
      "configurePreset": "release-gcc",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "coverage-gcc",
      "configurePreset": "coverage-gcc",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "^unit$"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "dev-gcc",
      "configurePreset": "dev-gcc",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "release-gcc",
      "configurePreset": "release-gcc",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "coverage-gcc",
      "configurePreset": "coverage-gcc",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "steps": [
        {
          "type": "configure",
          "name": "dev"
        },
        {
          "type": "build",
          "name": "dev"
        },
        {
          "type": "test",
          "name": "dev"
        }
      ]
    },
    {
      "name": "release",
      "steps": [
        {
          "type": "configure",
          "name": "release"
        },
        {
          "type": "build",
          "name": "release"
        },
        {
          "type": "test",
          "name": "release"
        }
      ]
    },
    {
      "name": "asan",
      "steps": [
        {
          "type": "configure",
          "name": "asan"
        },
        {
          "type": "build",
          "name": "asan"
        },
        {
          "type": "test",
          "name": "asan"
        }
      ]
    },
    {
      "name": "tsan",
      "steps": [
        {
          "type": "configure",
          "name": "tsan"
        },
        {
          "type": "build",
          "name": "tsan"
        },
        {
          "type": "test",
          "name": "tsan"
        }
      ]
    },
    {
      "name": "coverage",
      "steps": [
        {
          "type": "configure",
          "name": "coverage"
        },
        {
          "type": "build",
          "name": "coverage"
        },
        {
          "type": "test",
          "name": "coverage"
        }
      ]
    },
    {
      "name": "dev-gcc",
      "steps": [
        {
          "type": "configure",
          "name": "dev-gcc"
        },
        {
          "type": "build",
          "name": "dev-gcc"
        },
        {
          "type": "test",
          "name": "dev-gcc"
        }
      ]
    },
    {
      "name": "release-gcc",
      "steps": [
        {
          "type": "configure",
          "name": "release-gcc"
        },
        {
          "type": "build",
          "name": "release-gcc"
        },
        {
          "type": "test",
          "name": "release-gcc"
        }
      ]
    },
    {
      "name": "coverage-gcc",
      "steps": [
        {
          "type": "configure",
          "name": "coverage-gcc"
        },
        {
          "type": "build",
          "name": "coverage-gcc"
        },
        {
          "type": "test",
          "name": "coverage-gcc"
        }
      ]
    }
  ]
}
